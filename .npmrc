# @vercel/analytics declares an OPTIONAL peer on @remix-run/react, which in
# turn requires React 18. This project is React 19 and does not use Remix, so
# the peer is never installed — but npm still evaluates its requirements and
# fails the install with ERESOLVE.
#
# This file exists so that a clean `npm install` succeeds everywhere it has to,
# including on Vercel's build, which reads .npmrc and would otherwise fail the
# deploy with the same error. Remove it if that peer is ever fixed upstream.
legacy-peer-deps=true
