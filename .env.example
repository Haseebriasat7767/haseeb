# AURELIA — environment
#
# Nothing here is required to run the site. Every variable is optional and
# the app degrades honestly without it rather than pretending.

# ── Enquiries ─────────────────────────────────────────────────────────────
#
# The contact form posts to the app's own route, `app/api/enquiry`. That
# route sends over plain SMTP, using a mailbox you already own — there is no
# email vendor to sign up for. It needs ALL of the variables below to send.
# With any of them missing it answers 503 and the form falls back to
# composing the message and handing it to the visitor's mail client — which
# is honest, and is what the site did before the route existed.
#
# These are SERVER variables. They are never read in the browser and never
# reach the client bundle. Do not prefix them with NEXT_PUBLIC_.

# Your mail provider's outgoing server — the same value its own setup page
# gives you. e.g. smtp.gmail.com, smtp.office365.com, smtp.fastmail.com
SMTP_HOST=

# 587 (STARTTLS) is the default and what nearly every provider wants. Use
# 465 for implicit TLS. The route refuses to send unencrypted either way, so
# a port that cannot negotiate TLS will fail rather than send in the clear.
SMTP_PORT=587

# The mailbox to authenticate as — usually the full email address.
SMTP_USER=

# NOT your account password on any provider with two-factor authentication.
# Generate an app-specific password instead:
#   Google Workspace / Gmail  — myaccount.google.com/apppasswords
#   Microsoft 365 / Outlook   — account.microsoft.com security settings
# Never commit the real value. Set it in the host's environment settings.
SMTP_PASSWORD=

# Where enquiries land. The address the client actually reads.
ENQUIRY_TO=

# The address enquiries are sent FROM. On most providers this must be the
# same mailbox as SMTP_USER, or an alias it is permitted to send as —
# otherwise the server rejects the message or it lands in spam.
# e.g. AURELIA <enquiries@yourdomain.com>
ENQUIRY_FROM=

# ── Overrides ─────────────────────────────────────────────────────────────

# Points the form at a different endpoint entirely — a forms provider or a
# CRM webhook — instead of the built-in route. Public by design: it is a form
# action URL, not a credential.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Shown as the contact details across the site. Both null by default, which
# hides every channel rather than showing a placeholder a visitor might use.
NEXT_PUBLIC_ENQUIRY_EMAIL=
NEXT_PUBLIC_ENQUIRY_PHONE=

# Canonical origin, for metadata, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=
